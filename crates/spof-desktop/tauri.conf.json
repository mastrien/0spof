{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "0spof",
  "version": "0.3.1",
  "identifier": "com.mastrien.zerospof",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "0spof - Resiliência Acadêmica Moodle",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQTQxQjBBNzdEMjYzRTgKUldUb1k5SjNDaHVrSUVVUVRuYXJaWnhTN2RRTytWUGpzY2pHV3dmY0JUZXFaQU4xL0pYSHI4L2wK",
      "endpoints": [
        "https://github.com/mastrien/0spof/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
